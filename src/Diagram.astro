---
/**
 * sketch-diagrams — hand-drawn architecture diagrams for Astro, rendered to inline SVG at build time.
 * Strokes by rough.js (the engine behind Excalidraw); labels in Excalifont; icons from Lucide and Simple Icons.
 *
 * Nodes sit on a grid (`col`, `row`, 0-based). Boxes size themselves to their text; column gaps grow to fit
 * the longest edge label between them, so nothing overlaps. `x`/`y`/`w`/`h` override the layout when needed.
 *
 *   <Diagram title="Keyless trust" caption="…"
 *     nodes={[{ id: 'a', label: 'Build runner', sub: 'cloud A', col: 0, row: 0, kind: 'accent', icon: 'hammer' }]}
 *     edges={[{ from: 'a', to: 'b', label: 'signed token', dashed: true }]} />
 *
 * kind: 'default' | 'accent' | 'warm' | 'muted'      icon: Lucide name ('key-round') or 'si:<brand>' ('si:kubernetes')
 * Theme with CSS variables (see styles.css). Same `seed` → same strokes on every build.
 */
import rough from 'roughjs/bundled/rough.esm.js';
import * as lucide from 'lucide';
import * as simple from 'simple-icons';

export type Kind = 'default' | 'accent' | 'warm' | 'muted';
export interface Node { id: string; label: string; sub?: string; icon?: string; kind?: Kind; col?: number; row?: number; x?: number; y?: number; w?: number; h?: number }
export interface Edge { from: string; to: string; label?: string; dashed?: boolean; both?: boolean }
export interface Props { title: string; caption?: string; nodes: Node[]; edges?: Edge[]; seed?: number; colGap?: number; rowGap?: number; width?: number; height?: number; roughness?: number }
const { title, caption, nodes, edges = [], seed = 42, colGap: minColGap = 90, rowGap = 70, roughness = 1.0 } = Astro.props as Props;

// Text metrics in viewBox units: Excalifont 17px ≈ 9px/char; mono sub 10px tracked ≈ 7px/char; edge label 14px ≈ 8.2px/char.
const LABEL_PX = 9, SUB_PX = 7, EDGE_PX = 8.2, PAD = 18, ICON_W = 34, MARGIN = 24;

function iconMarkup(name: string): string {
  if (name.startsWith('si:')) {
    const key = 'si' + name.slice(3).replace(/[^a-z0-9]/gi, '').replace(/^./, (c) => c.toUpperCase());
    const icon = (simple as Record<string, { path: string }>)[key];
    if (!icon) throw new Error(`sketch-diagrams: unknown Simple Icon "${name}"`);
    return `<path d="${icon.path}" fill="currentColor" stroke="none" />`;
  }
  const pascal = name.replace(/(^|-)([a-z0-9])/g, (_, __, c) => c.toUpperCase());
  const node = (lucide as Record<string, [string, Record<string, string>][]>)[pascal];
  if (!node) throw new Error(`sketch-diagrams: unknown Lucide icon "${name}"`);
  return node.map(([tag, attrs]) => `<${tag} ${Object.entries(attrs).map(([k, v]) => `${k}="${v}"`).join(' ')} />`).join('');
}

type Box = Node & { w: number; h: number; x: number; y: number; textW: number; placed: boolean };
const sized: Box[] = nodes.map((n) => {
  const textW = Math.max(n.label.length * LABEL_PX, (n.sub?.length ?? 0) * SUB_PX);
  return { ...n, w: n.w ?? Math.max(120, textW + PAD * 2 + (n.icon ? ICON_W : 0)), h: n.h ?? (n.sub ? 60 : 46), x: n.x ?? 0, y: n.y ?? 0, textW, placed: n.x !== undefined && n.y !== undefined };
});
const byId: Record<string, Box> = Object.fromEntries(sized.map((b) => [b.id, b]));

const cols = Math.max(0, ...sized.map((b) => (b.col ?? 0) + 1));
const colW = Array.from({ length: cols }, (_, c) => Math.max(0, ...sized.filter((b) => (b.col ?? 0) === c).map((b) => b.w)));
const gapAfter = Array.from({ length: Math.max(0, cols - 1) }, () => minColGap);
for (const e of edges) {
  const a = byId[e.from], b = byId[e.to];
  if (!a || !b || !e.label) continue;
  const ca = a.col ?? 0, cb = b.col ?? 0;
  if (Math.abs(ca - cb) === 1 && (a.row ?? 0) === (b.row ?? 0)) {
    const g = Math.min(ca, cb);
    gapAfter[g] = Math.max(gapAfter[g], e.label.length * EDGE_PX + 28);
  }
}
const colX: number[] = [];
let cx = MARGIN;
for (let c = 0; c < cols; c++) { colX[c] = cx; cx += colW[c] + (gapAfter[c] ?? 0); }
const rowH = Math.max(46, ...sized.map((b) => b.h));
for (const b of sized) {
  if (b.placed) continue;
  const c = b.col ?? 0, r = b.row ?? 0;
  b.x = colX[c] + (colW[c] - b.w) / 2;
  b.y = MARGIN + r * (rowH + rowGap) + (rowH - b.h) / 2;
}

const gen = rough.generator();
let n = 0;
const opts = (extra: Record<string, unknown> = {}) => ({ roughness, bowing: 0.8, strokeWidth: 1.4, seed: seed + n++, ...extra });
const center = (b: Box) => ({ x: b.x + b.w / 2, y: b.y + b.h / 2 });
function exit(b: Box, to: { x: number; y: number }) {
  const c = center(b), dx = to.x - c.x, dy = to.y - c.y;
  if (dx === 0 && dy === 0) return c;
  const sx = dx !== 0 ? (b.w / 2) / Math.abs(dx) : Infinity, sy = dy !== 0 ? (b.h / 2) / Math.abs(dy) : Infinity;
  const s = Math.min(sx, sy) + 0.06;
  return { x: c.x + dx * s, y: c.y + dy * s };
}
// rough.js needs literal colours to decide fill vs stroke paths; the classes below carry the real theme colours.
const boxes = sized.map((b) => {
  const kind = b.kind ?? 'default';
  const hatch = kind === 'accent' || kind === 'warm';
  const d = gen.rectangle(b.x, b.y, b.w, b.h, opts({ stroke: '#000', ...(hatch ? { fill: '#000', fillStyle: 'hachure', hachureAngle: -41, hachureGap: 10, fillWeight: 0.5 } : {}), strokeLineDash: kind === 'muted' ? [6, 5] : undefined }));
  // rough emits the hachure as a separate path with strokeWidth = fillWeight; the outline keeps strokeWidth 1.4
  const paths = gen.toPaths(d).map((p) => ({ d: p.d, hatch: p.strokeWidth < 1 }));
  return { ...b, kind, paths, ico: b.icon ? iconMarkup(b.icon) : '', dx: b.icon ? ICON_W / 2 : 0, plateW: b.textW + 12 };
});
const lines = edges.map((e) => {
  const a = byId[e.from], b = byId[e.to];
  if (!a || !b) throw new Error(`sketch-diagrams "${title}": unknown node in edge ${e.from} -> ${e.to}`);
  const p1 = exit(a, center(b)), p2 = exit(b, center(a));
  const line = gen.line(p1.x, p1.y, p2.x, p2.y, opts({ stroke: '#000', strokeLineDash: e.dashed ? [7, 6] : undefined }));
  const ang = Math.atan2(p2.y - p1.y, p2.x - p1.x), L = 11, spread = 0.46;
  const head = (tip: { x: number; y: number }, dir: number) => [
    gen.line(tip.x, tip.y, tip.x - dir * L * Math.cos(ang + spread), tip.y - dir * L * Math.sin(ang + spread), opts({ stroke: '#000' })),
    gen.line(tip.x, tip.y, tip.x - dir * L * Math.cos(ang - spread), tip.y - dir * L * Math.sin(ang - spread), opts({ stroke: '#000' })),
  ];
  const heads = [...head(p2, 1), ...(e.both ? head(p1, -1) : [])];
  const horizontal = Math.abs(p2.y - p1.y) < Math.abs(p2.x - p1.x) * 0.6;
  const vertical = Math.abs(p2.x - p1.x) < Math.abs(p2.y - p1.y) * 0.6;
  const mid = { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };
  const label = e.label ? { text: e.label, w: e.label.length * EDGE_PX + 12, x: vertical ? mid.x + 10 : mid.x, y: horizontal ? mid.y - 14 : mid.y, anchor: vertical ? 'start' : 'middle' } : null;
  return { ...e, paths: [line, ...heads].flatMap((d) => gen.toPaths(d).map((p) => p.d)), label };
});
const labelRight = Math.max(0, ...lines.filter((l) => l.label).map((l) => (l.label!.anchor === 'start' ? l.label!.x - 4 : l.label!.x - l.label!.w / 2) + l.label!.w));
const labelBottom = Math.max(0, ...lines.filter((l) => l.label).map((l) => l.label!.y + 10));
const width = (Astro.props as Props).width ?? Math.max(labelRight, ...sized.map((b) => b.x + b.w)) + MARGIN;
const height = (Astro.props as Props).height ?? Math.max(labelBottom, ...sized.map((b) => b.y + b.h)) + MARGIN;
const uid = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40);
---
<figure class="sd">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${uid}-t`} class="sd-svg">
    <title id={`${uid}-t`}>{title}</title>
    {lines.map((l) => (
      <g class="sd-edge">{l.paths.map((d) => <path d={d} stroke-width="1.4" />)}</g>
    ))}
    {boxes.map((b) => (
      <g class:list={['sd-node', b.kind]}>
        {b.paths.map((p) => <path d={p.d} class={p.hatch ? 'sd-hatch' : 'sd-outline'} stroke-width={p.hatch ? 0.7 : 1.4} />)}
        <rect x={b.x + b.w / 2 + b.dx - b.plateW / 2} y={b.y + 6} width={b.plateW} height={b.h - 12} rx="3" class="sd-plate" />
        {b.ico && (
          <g class="sd-ico">
            <rect x={b.x + 10} y={b.y + b.h / 2 - 15} width="30" height="30" rx="4" class="sd-plate" />
            <svg x={b.x + 13} y={b.y + b.h / 2 - 12} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={b.ico} />
          </g>
        )}
        <text x={b.x + b.w / 2 + b.dx} y={b.y + b.h / 2 + (b.sub ? -3 : 6)} text-anchor="middle" class="sd-text">{b.label}</text>
        {b.sub && <text x={b.x + b.w / 2 + b.dx} y={b.y + b.h / 2 + 15} text-anchor="middle" class="sd-sub">{b.sub}</text>}
      </g>
    ))}
    {lines.filter((l) => l.label).map((l) => (
      <g class="sd-edge-label">
        <rect x={l.label!.anchor === 'start' ? l.label!.x - 4 : l.label!.x - l.label!.w / 2} y={l.label!.y - 10} width={l.label!.w} height="20" rx="3" class="sd-label-bg" />
        <text x={l.label!.x} y={l.label!.y + 5} text-anchor={l.label!.anchor} class="sd-label">{l.label!.text}</text>
      </g>
    ))}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
